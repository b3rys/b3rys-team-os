#!/usr/bin/env bash
# team-os — 팀 서버와 빌을 올리거나 내린다.
#
#   team-os up      안 떠 있는 것을 올린다 (서버·팀원·다리 전부)
#   team-os doctor  왜 안 뜨는지 본다
#   team-os down    내린다
#
# ★전원을 껐다 켜면 저절로 올라온다.★ 이건 그게 안 됐을 때 쓴다.
set -uo pipefail

URL="http://127.0.0.1:7878/team/"

# 저장소 위치를 짐작하지 않는다 — ★이 스크립트 자신이 저장소 안에 있다.★
#   경로가 `<저장소>/scripts/team-os` 이므로 자기 위치의 한 단계 위가 저장소다.
#   짐작하면 틀린다: 우리는 ~/Development/ 밑에 두지만 공개 사용자는 README 대로
#   아무 데서나 `git clone` 하므로 대개 홈 바로 밑이다. 그 경우 예전 기본값으로는
#   ★자기 서비스를 하나도 못 찾는다.★
#   ~/team-os 같은 심링크로 부를 수 있으니 심링크를 끝까지 따라간다.
_self="$0"
while [ -L "$_self" ]; do
  _link="$(readlink "$_self")"
  case "$_link" in
    /*) _self="$_link" ;;
    *)  _self="$(dirname "$_self")/$_link" ;;
  esac
done
REPO="${TEAM_OS_REPO:-$(cd "$(dirname "$_self")/.." 2>/dev/null && pwd)}"
if [ -z "$REPO" ] || [ ! -d "$REPO/src/server" ]; then
  echo "✗ 저장소를 못 찾았습니다 (찾은 곳: ${REPO:-없음})"
  echo "  이 스크립트는 <저장소>/scripts/team-os 자리에 있어야 합니다."
  echo "  다른 데서 쓰시려면: TEAM_OS_REPO=<저장소 경로> team-os $*"
  exit 1
fi

# plist 안의 :Label 을 실제로 읽는다 — ★파일명이 곧 라벨이 아니다.★ (codex 지적)
label_of() { /usr/libexec/PlistBuddy -c 'Print :Label' "$1" 2>/dev/null; }

# 이 저장소에 속하고 '켜 두면 계속 떠 있어야 하는' 자동실행 전부 — "라벨|plist" 줄들.
#   이름을 고정하지 않는다: 팀원 이름은 설치마다 다르다(공개 사용자·다른 맥).
#
# 판별 기준 — 시간 트리거가 있으면 예약 작업, 없으면 상주 서비스.
#   StartCalendarInterval / StartInterval 이 있으면 제외한다. 그건 때 되면 알아서 돌고,
#   다시 등록하면 같은 일이 두 번 돈다. (codex 지적)
#   RunAtLoad 만으로 거르면 안 된다 — KeepAlive 는 RunAtLoad 를 암묵적으로 포함하므로
#   KeepAlive 만 있고 RunAtLoad 키가 없는 정상 상주 서비스가 빠진다. (codex 지적)
has_key() { /usr/libexec/PlistBuddy -c "Print :$2" "$1" >/dev/null 2>&1; }
plist_val() { /usr/libexec/PlistBuddy -c "Print :$2" "$1" 2>/dev/null; }

# KeepAlive 는 키가 있는지가 아니라 값을 봐야 한다 — 우리 팀원 plist 가 실제로 KeepAlive=false 다.
#   false 면 상주가 아니다. true 이거나 조건 dict 면 상주다. (codex 지적)
keepalive_on() {
  case "$(plist_val "$1" KeepAlive)" in
    true|Dict*) return 0 ;;
    *) return 1 ;;
  esac
}

boot_services() {
  local f lbl
  for f in "$HOME/Library/LaunchAgents"/*.plist; do
    [ -f "$f" ] || continue
    case "$f" in *.bak*) continue ;; esac
    # -F: 경로의 . 등이 정규식으로 해석되어 엉뚱한 파일에 맞는 것을 막는다 (codex 지적)
    grep -Fq -- "$REPO" "$f" 2>/dev/null || continue
    has_key "$f" StartCalendarInterval && continue
    has_key "$f" StartInterval && continue
    [ "$(plist_val "$f" RunAtLoad)" = "true" ] || keepalive_on "$f" || continue
    lbl="$(label_of "$f")"; [ -n "$lbl" ] || lbl="$(basename "$f" .plist)"
    # 라벨과 경로는 launchd 관례 문자만 지원한다고 명시한다. 아래에서 | 로 구분해 넘기므로
    #   임의 문자열을 지원한다고 말할 수 없다 — 지원 범위를 좁히고 밝히는 쪽을 택했다. (codex 지적)
    #   벗어나면 조용히 빼지 않고 ★실패로 센다★ — '전부 올린다' 고 해놓고 몰래 빼면 거짓말이다.
    case "$lbl$f" in
      *[!A-Za-z0-9._/-]*) printf '!지원밖|%s\n' "$f"; continue ;;
    esac
    printf '%s|%s\n' "$lbl" "$f"
  done
}

loaded() { launchctl print "gui/$(id -u)/$1" >/dev/null 2>&1; }

# 팀원 런처인가. 런처는 팀원을 tmux 로 띄우고 자기는 끝난다 — 그래서 launchd 상태로는
#   살았는지 알 수 없다. 세션 이름은 런처에 넘기는 이름에서 나온다 (claude-<이름>).
member_of() {
  plist_val "$1" ProgramArguments \
    | awk '/start-telegram-channel\.sh/ { hit = 1; next }
           hit && NF && $1 !~ /^[{}]$/ { gsub(/^[ \t]+|[ \t]+$/, "", $0); print; exit }'
}

tmux_session_up() { tmux has-session -t "$1" 2>/dev/null; }

# 지금 실제로 살아 있나. 서비스 종류마다 답이 다르다.
#   런처 계열 = tmux 세션이 있나          (launchd 는 exit 0 인 채로 남는다)
#   상주 계열 = state = running 인가
# ★last exit code 0 은 과거 사실이다.★ 그걸로 판정하면 tmux 가 죽은 뒤에도 정상으로 보인다 —
#   이 도구가 잡으라고 만들어진 바로 그 상황을 놓친다. (codex 지적, 실제로 그렇게 짰다가 고침)
service_healthy() {  # service_healthy <라벨> <plist>
  local m
  m="$(member_of "$2")"
  if [ -n "$m" ]; then
    tmux_session_up "claude-$m"
    return $?
  fi
  launchctl print "gui/$(id -u)/$1" 2>/dev/null | grep -q "state = running"
}

alive() { [ "$(curl -s -o /dev/null -m 3 -w '%{http_code}' "$URL" 2>/dev/null || echo 000)" = "200" ]; }

show() {
  if alive; then
    local n; n="$(curl -s -m 3 "${URL}api/agents" 2>/dev/null \
      | /usr/bin/python3 -c 'import sys,json;print(len(json.load(sys.stdin)["agents"]))' 2>/dev/null || echo '?')"
    echo "  ✓ 서버 정상 (팀원 ${n}명)"
  else
    echo "  ✗ 서버 응답 없음"
  fi
  # 팀원 이름을 고정하지 않는다 — 설치마다 다르다. 발견한 것 중 몇 개가 정상인지로 말한다.
  local total=0 ok=0 lbl plist
  while IFS='|' read -r lbl plist; do
    [ -n "$lbl" ] && [ "$lbl" != "!지원밖" ] || continue
    total=$((total + 1))
    loaded "$lbl" && service_healthy "$lbl" "$plist" && ok=$((ok + 1))
  done < <(boot_services)
  if [ "$total" -eq 0 ]; then
    echo "  ✗ 자동실행을 하나도 못 찾았습니다 (설치가 덜 된 상태)"
  elif [ "$ok" -eq "$total" ]; then
    echo "  ✓ 자동실행 ${total}개 전부 정상"
  else
    echo "  ✗ 자동실행 ${total}개 중 ${ok}개만 정상"
  fi
}

case "${1:-up}" in
  up)
    echo "■ 올립니다"
    # 안 떠 있는 것만 올린다. 이미 떠 있는 걸 다시 올리면 막 올라오던 것을 죽인다 (steve 지적).
    #   20초 안에 안 뜨면 사람은 up 을 다시 누르므로, 보호가 없으면 그 행동이 제일 나쁜 결과를 낸다.
    FAILED=""
    while IFS='|' read -r _lbl _plist; do
      [ -n "$_lbl" ] || continue
      if [ "$_lbl" = "!지원밖" ]; then
        echo "  ✗ 다룰 수 없는 자동실행 파일입니다 (이름에 예상 밖 문자): $_plist"
        FAILED="$FAILED $(basename "$_plist")"
        continue
      fi
      if loaded "$_lbl"; then
        # 등록돼 있다고 살아 있는 건 아니다. 실제 상태를 보고 죽었으면 다시 올린다.
        #   런처는 자기 안에 '이미 떠 있으면 아무것도 안 한다' 가드가 있어 다시 불러도 안전하다.
        if service_healthy "$_lbl" "$_plist"; then
          echo "  · $_lbl (정상)"
        else
          launchctl kickstart -k "gui/$(id -u)/$_lbl" >/dev/null 2>&1
          echo "  → $_lbl 다시 올림"
        fi
        continue
      fi
      # 다른 도메인에 같은 라벨이 있으면 gui 에 또 올리지 않는다 — 같은 것이 둘로 돈다.
      #   gui 와 user 는 서로 다른 서비스 집합이라 gui 조회로는 안 보인다. (codex 지적)
      if launchctl print "user/$(id -u)/$_lbl" >/dev/null 2>&1; then
        echo "  ✗ $_lbl — user 도메인에 이미 있습니다. gui 에 또 올리면 둘로 돕니다."
        echo "     먼저 확인하세요: launchctl print user/$(id -u)/$_lbl"
        FAILED="$FAILED $_lbl"
        continue
      fi
      # bootstrap 의 종료코드를 본다. 안 보면 Disabled·권한·깨진 plist 가
      #   전부 '등록됨' 으로 찍힌다 — 복구 도구가 거짓말을 하는 것이 제일 나쁘다. (codex·steve 지적)
      if _err="$(launchctl bootstrap "gui/$(id -u)" "$_plist" 2>&1)"; then
        echo "  → $_lbl 등록"
      else
        echo "  ✗ $_lbl 등록 실패 — ${_err:-(메시지 없음)}"
        FAILED="$FAILED $_lbl"
      fi
    done < <(boot_services)
    # 서버 HTTP 는 ★확인용으로만★ 쓴다. 여기서 다시 올리지 않는다.
    #   프로세스는 살아 있는데 HTTP 가 아직 안 열린 상태(부팅 직후)가 정상적으로 있고,
    #   그때 재시작하면 ★막 올라오던 서버를 죽이고 처음부터★ 시작한다 —
    #   이 도구가 지키려는 바로 그 조건을 스스로 깬다. (codex 지적)
    #   안 떠 있는 서버는 위 루프가 이미 올린다(state 로 판정).
    alive && echo "  · 서버 응답 정상" || echo "  · 서버 응답 아직 없음 (기다립니다)"
    echo "■ 20초 기다립니다…"; sleep 20
    echo "■ 결과"; show
    # 전부 지금 살아 있는지 다시 본다. 등록만 되고 죽어 있어도 '됐습니다' 가 나오면
    #   이 도구는 쓸모가 없다 — 안 뜬 걸 찾으라고 만든 도구다. (codex 지적)
    NOTUP=""
    while IFS='|' read -r _lbl _plist; do
      [ -n "$_lbl" ] || continue
      [ "$_lbl" = "!지원밖" ] && continue   # 위에서 이미 실패로 셌다
      loaded "$_lbl" && service_healthy "$_lbl" "$_plist" || NOTUP="$NOTUP $_lbl"
    done < <(boot_services)
    [ -n "$FAILED" ] && { echo; echo "  등록 실패:$FAILED"; }
    if [ -n "$NOTUP" ] || [ -n "$FAILED" ] || ! alive; then
      echo
      [ -n "$NOTUP" ] && echo "  아직 안 떴습니다:$NOTUP"
      alive || echo "  서버가 아직 응답하지 않습니다"
      echo "  → team-os doctor 를 돌리고 나온 내용을 팀원에게 주세요."
      exit 1
    fi
    echo; echo "  됐습니다. 텔레그램으로 팀원에게 말 거세요."
    ;;
  down)
    # up 과 대칭이다 — up 이 올리는 것을 down 이 전부 내린다. (GD 판단, 2026-07-29)
    #   맥을 끄기 전에 팀을 통째로 세우는 것이 이 명령의 목적이다.
    #   예약 작업은 여기서도 대상이 아니다 — 애초에 상주가 아니다.
    # 사람이 터미널에서 실행하십시오. 팀원에게 시키면 그 팀원이 자기 세션을 닫는 도중
    #   끊겨서, 나머지가 다 내려갔는지 확인할 사람이 사라집니다. (steve 지적)
    echo "■ 내립니다"
    DOWNFAIL=""
    while IFS='|' read -r _lbl _plist; do
      [ -n "$_lbl" ] || continue
      if [ "$_lbl" = "!지원밖" ]; then
        echo "  ✗ 다룰 수 없는 자동실행 파일 — $_plist"
        DOWNFAIL="$DOWNFAIL $(basename "$_plist")"
        continue
      fi
      launchctl bootout "gui/$(id -u)/$_lbl" >/dev/null 2>&1
      # 런처 계열은 자기가 이미 끝났고 tmux 세션만 남아 있다 — 그것도 같이 닫는다.
      #   자동실행만 내리면 팀원은 계속 살아 있다.
      _m="$(member_of "$_plist")"
      if [ -n "$_m" ] && tmux_session_up "claude-$_m"; then
        tmux kill-session -t "claude-$_m" >/dev/null 2>&1
        echo "  → $_lbl (세션도 닫음)"
      else
        echo "  → $_lbl"
      fi
    done < <(boot_services)
    sleep 3
    # 정말 내려갔는지 확인한다. 내리는 명령이 실패해도 성공처럼 끝나면
    #   맥을 끄는 사람이 다 세운 줄 안다 — 파괴 동작의 실패를 숨기면 안 된다. (codex 지적)
    while IFS='|' read -r _lbl _plist; do
      [ -n "$_lbl" ] || continue
      [ "$_lbl" = "!지원밖" ] && continue
      _m="$(member_of "$_plist")"
      if loaded "$_lbl"; then
        DOWNFAIL="$DOWNFAIL $_lbl"
      elif [ -n "$_m" ] && tmux_session_up "claude-$_m"; then
        DOWNFAIL="$DOWNFAIL claude-$_m(세션)"
      fi
    done < <(boot_services)
    echo "■ 결과"; show
    echo
    if [ -n "$DOWNFAIL" ]; then
      echo "  ✗ 아직 안 내려간 것:$DOWNFAIL"
      echo "  → 다시 한 번 team-os down 을 해보고, 그래도 남으면 team-os doctor 출력을 팀원에게 주세요."
      exit 1
    fi
    echo "  전부 내렸습니다. 다시 올릴 때: team-os up"
    ;;
  doctor)
    echo "■ 점검"
    show
    echo
    # 하나하나 다 보여준다 — 이 출력을 그대로 팀원에게 주라고 만든 화면이다.
    echo "■ 하나씩"
    _any=0
    while IFS='|' read -r _lbl _plist; do
      [ -n "$_lbl" ] || continue
      _any=1
      if [ "$_lbl" = "!지원밖" ]; then
        echo "  ✗ 다룰 수 없는 파일 — $_plist"
      elif ! loaded "$_lbl"; then
        echo "  ! $_lbl — 파일은 있는데 등록이 안 됨 → team-os up"
      elif service_healthy "$_lbl" "$_plist"; then
        echo "  ✓ $_lbl — 정상"
      else
        echo "  ✗ $_lbl — 등록은 됐는데 안 돌고 있음 → team-os up"
      fi
    done < <(boot_services)
    [ "$_any" = "1" ] || echo "  ✗ 자동실행 파일을 하나도 못 찾았습니다 — ls ~/Library/LaunchAgents/"
    echo
    echo "■ 마지막 오류 3줄"
    if [ -f "$REPO/logs/stderr.log" ]; then tail -3 "$REPO/logs/stderr.log" | sed 's/^/  /'
    else echo "  (로그 파일 없음: $REPO/logs/stderr.log)"; fi
    echo
    # 팀원 이름을 고정하지 않는다 — 빌이 없는 설치에서도 맞는 판정이어야 한다. (codex 지적)
    #   하나도 못 찾은 것도 비정상이다. 안 세면 위에서는 "하나도 못 찾음" 이라 해놓고
    #   여기서는 "정상" 이라고 말한다 — 설치가 덜 된 사람에게 제일 나쁜 답이다. (codex 지적)
    _bad=""; _found=0
    while IFS='|' read -r _lbl _plist; do
      [ -n "$_lbl" ] || continue
      _found=$((_found + 1))
      [ "$_lbl" = "!지원밖" ] && { _bad=1; continue; }
      loaded "$_lbl" && service_healthy "$_lbl" "$_plist" || _bad=1
    done < <(boot_services)
    [ "$_found" -eq 0 ] && _bad=1
    if alive && [ -z "$_bad" ]; then
      echo "  정상입니다. 할 것 없습니다."
    else
      echo "  team-os up 을 먼저 해보세요. 그래도 안 되면 위 내용을 팀원에게 주세요."
    fi
    ;;
  *)
    echo "사용법: team-os up | team-os doctor | team-os down"
    echo "  up      올린다"
    echo "  doctor  왜 안 뜨는지 본다"
    echo "  down    내린다"
    exit 1 ;;
esac
